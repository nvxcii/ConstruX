# ConstruX - Git Ignore

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# Virtual environments
venv/
env/
ENV/

# Build artifacts
build/
dist/
*.egg-info/
.eggs/

# Environment and secrets
.env
*.key
secrets/
config/.env

# Output and exports
output/
exports/
tmp/
temp/
*.tmp

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Testing
.pytest_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints

# Logs
*.log
logs/
