# MPRP Relay Bot Configuration
# Copy this file to .env and fill in your Discord bot token.
#
# To create a bot:
#   1. Go to https://discord.com/developers/applications
#   2. Click "New Application" -> name it "MPRP Relay"
#   3. Go to "Bot" tab -> click "Add Bot"
#   4. Copy the token below
#   5. Under "Privileged Gateway Intents", enable:
#      - MESSAGE CONTENT INTENT
#      - SERVER MEMBERS INTENT
#   6. Go to "OAuth2" -> "URL Generator"
#      - Scopes: bot
#      - Bot Permissions: Manage Channels, Manage Roles, Send Messages,
#        Embed Links, Add Reactions, Manage Messages, Read Message History
#   7. Copy the generated URL and open it to invite the bot to your server

DISCORD_BOT_TOKEN=your_token_here

# Optional: lock to a specific server (guild ID)
# DISCORD_GUILD_ID=123456789
